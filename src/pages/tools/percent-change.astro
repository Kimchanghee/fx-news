---
import Base from '../../layouts/Base.astro';
import site from '../../site.config';
import { fitTitle, fitDesc } from '../../lib/seo';
import { pctChange, logReturn, cagr } from '../../lib/calc.mjs';
import { commodityBySlug, commodityStats, fmtMonth, num } from '../../lib/data';

const g = commodityStats(commodityBySlug('gold'));
const a = g.y5.value!, b = g.latest;
const exPct = pctChange(a, b)!, exLog = logReturn(a, b)!, exCagr = cagr(a, b, 5)!;
const back = pctChange(b, a)!;

const title = fitTitle(['Percent Change Calculator for Prices and Exchange Rates', 'Percent Change Calculator: Prices, Rates and Annual Growth']);
const description = fitDesc([
  'Work out the percentage change between two prices or exchange rates, plus the log return, the compound annual rate and the move needed to get back again.',
]);
const ld = [{
  '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Percent change calculator', url: `${site.url}/tools/percent-change/`,
  applicationCategory: 'FinanceApplication', operatingSystem: 'Any', isAccessibleForFree: true,
  description: 'Calculates percentage change, log return, compound annual growth rate and the reverse move between two values.',
  publisher: { '@id': `${site.url}/#org` },
}];
---
<Base title={title} description={description} path="/tools/percent-change/" og="tool-percent" ld={ld} nav="tools"
  crumbs={[{ name: 'Board', href: '/' }, { name: 'Tools', href: '/tools/' }, { name: 'Percent change', href: '/tools/percent-change/' }]}>
  <div class="kicker">Tool · runs in your browser</div>
  <h1>How do you calculate the percentage change between two prices?</h1>
  <p id="answer" class="lede">
    Subtract the old value from the new one, divide by the old value and multiply by 100. Gold averaged ${num(a, 0)} an ounce in {fmtMonth(g.y5.month)} and ${num(b, 0)} in {fmtMonth(g.latestMonth)}: ({num(b, 0)} − {num(a, 0)}) ÷ {num(a, 0)} × 100 = {exPct >= 0 ? '+' : '−'}{Math.abs(exPct).toFixed(1)}%, or {exCagr >= 0 ? '+' : '−'}{Math.abs(exCagr).toFixed(1)}% a year over five years.
  </p>

  <form class="tool" id="pc" novalidate>
    <div class="fields">
      <div><label for="a">Old value</label><input id="a" inputmode="decimal" autocomplete="off" value={String(a)} required /></div>
      <div><label for="b">New value</label><input id="b" inputmode="decimal" autocomplete="off" value={String(b)} required /></div>
      <div><label for="y">Years between (optional)</label><input id="y" inputmode="decimal" autocomplete="off" value="5" aria-describedby="y-h" /><p class="hint" id="y-h">For the compound annual rate. Months ÷ 12.</p></div>
    </div>
    <p style="margin-top:1rem"><button type="submit">Calculate</button></p>
    <p class="err" id="err" role="alert"></p>
    <div class="out" id="out" aria-live="polite">
      <p class="state">Example (gold, {fmtMonth(g.y5.month)} → {fmtMonth(g.latestMonth)}, computed when the page was built):</p>
      <p class="res">{exPct >= 0 ? '+' : '−'}{Math.abs(exPct).toFixed(2)}%</p>
      <p>Difference {num(b - a, 2)} · log return {exLog.toFixed(2)}% · compound annual rate {exCagr.toFixed(2)}% over 5 years · to get back to {num(a, 0)} the price would have to move {back.toFixed(2)}%.</p>
    </div>
  </form>

  <h2>Which number should you quote?</h2>
  <ol class="notes">
    <li><strong>Percentage change</strong> answers “how much bigger or smaller?” It is not symmetric: a 50% fall needs a 100% rise to recover, which is why the calculator shows the reverse move.</li>
    <li><strong>Log return</strong> (natural logarithm of new ÷ old) adds up across periods and treats rises and falls symmetrically. Volatility figures on this site are built from log changes. See <a href="/guides/percent-change-vs-log-returns/">percent change vs log returns</a>.</li>
    <li><strong>Compound annual rate</strong> spreads a multi-year change evenly: (new ÷ old)<sup>1/years</sup> − 1. It describes the start and end points only, not the path in between.</li>
    <li>When the values are themselves percentages, such as interest rates, the plain difference is in <em>percentage points</em>; the calculator’s percentage change is a different quantity.</li>
  </ol>
  <p>Data for real examples is on the <a href="/commodities/">commodity board</a> and the <a href="/fx/">currency board</a>.</p>
</Base>

<script>
  import { pctChange, logReturn, cagr } from '../../lib/calc.mjs';
  const f = document.getElementById('pc') as HTMLFormElement;
  const out = document.getElementById('out')!;
  const err = document.getElementById('err')!;
  const ids = ['a', 'b', 'y'] as const;
  const el = Object.fromEntries(ids.map((k) => [k, document.getElementById(k) as HTMLInputElement])) as Record<(typeof ids)[number], HTMLInputElement>;
  const parse = (s: string) => (s.trim() === '' ? NaN : Number(s.replace(/[,\s$€£¥]/g, '')));
  const fmt = (v: number, d = 2) => v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
  const sg = (v: number, d = 2) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${fmt(Math.abs(v), d)}`;
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    err.textContent = '';
    out.textContent = '';
    ids.forEach((k) => el[k].removeAttribute('aria-invalid'));
    const a = parse(el.a.value), b = parse(el.b.value), y = el.y.value.trim() === '' ? null : parse(el.y.value);
    const bad = (k: (typeof ids)[number], msg: string) => { el[k].setAttribute('aria-invalid', 'true'); err.textContent = msg; el[k].focus(); };
    if (!Number.isFinite(a)) return bad('a', 'Enter the old value as a number.');
    if (a === 0) return bad('a', 'The old value cannot be zero: a percentage change from zero is undefined.');
    if (!Number.isFinite(b)) return bad('b', 'Enter the new value as a number.');
    if (y !== null && (!Number.isFinite(y) || y <= 0 || y > 200)) return bad('y', 'Years must be a number above 0 (and at most 200), or left empty.');
    const pc = pctChange(a, b);
    if (pc === null || !Number.isFinite(b - a)) return bad('b', 'The result exceeds the supported numeric range. Use smaller values.');
    const lr = logReturn(a, b);
    const cg = y !== null ? cagr(a, b, y) : null;
    const back = b !== 0 ? pctChange(b, a) : null;
    const parts = [`Difference ${sg(b - a)}`];
    parts.push(lr === null ? 'log return not defined (values must both be above zero)' : `log return ${sg(lr)}%`);
    if (y !== null) parts.push(cg === null ? 'compound annual rate unavailable for these values or outside the supported numeric range' : `compound annual rate ${sg(cg)}% over ${fmt(y, y % 1 ? 2 : 0)} years`);
    if (back !== null) parts.push(`to return to ${fmt(a)} the value would have to move ${sg(back)}%`);
    out.innerHTML = `<p class="state">From ${fmt(a)} to ${fmt(b)}${a < 0 ? ' (negative starting value: change measured against its absolute size)' : ''}</p><p class="res">${sg(pc)}%</p><p>${parts.join(' · ')}.</p>`;
    (window as any).gtag?.('event', 'tool_used', { tool: 'percent_change' });
  });
</script>
