---
import '../styles/global.css';
import site from '../site.config';
import { abs, orgLd, websiteLd, crumbsLd } from '../lib/seo';
import { fx, cm, fmtDate, fmtMonthLong } from '../lib/data';

interface Props {
  title: string;
  description: string;
  path: string; // e.g. '/fx/eur-usd/'
  og?: string; // file name in /og without extension
  ld?: object[];
  crumbs?: { name: string; href: string }[];
  nav?: 'board' | 'fx' | 'commodities' | 'tools' | 'guides' | 'method' | '';
  ogType?: 'website' | 'article';
}
const { title, description, path, og = 'home', ld = [], crumbs, nav = '', ogType = 'website' } = Astro.props;
const canonical = abs(path);
const ogImage = `${site.url}/og/${og}.png`;
const lds: object[] = [...(path === '/' ? [orgLd, websiteLd] : []), ...(crumbs ? [crumbsLd(crumbs)] : []), ...ld];
const navItems = [
  { k: 'board', href: '/', label: 'Board' },
  { k: 'fx', href: '/fx/', label: 'Currencies' },
  { k: 'commodities', href: '/commodities/', label: 'Commodities' },
  { k: 'tools', href: '/tools/', label: 'Tools' },
  { k: 'guides', href: '/guides/', label: 'Almanac' },
  { k: 'method', href: '/methodology/', label: 'Method' },
];
const consentDenied = { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', region: site.consentRegions, wait_for_update: 500 };
const consentGranted = { ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted', analytics_storage: 'granted', wait_for_update: 500 };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#1c2321" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/barlow-condensed-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="alternate" type="application/rss+xml" title={`${site.name} — Almanac guides`} href="/feed.xml" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}
  {site.naverVerification && <meta name="naver-site-verification" content={site.naverVerification} />}
  <meta name="google-adsense-account" content={site.adsenseClient} />
  {site.ga4Id && (
    <>
      <script is:inline define:vars={{ id: site.ga4Id, consentDenied, consentGranted }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('consent', 'default', consentDenied);
        gtag('consent', 'default', consentGranted);
        gtag('js', new Date());
        gtag('config', id);
      </script>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`}></script>
    </>
  )}
  <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>
  {lds.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="mast">
    <div class="wrap mast-top">
      <a class="brand" href="/">FX &amp; Commodity <span>Almanac</span></a>
      <p class="dateline">ECB fixings to {fmtDate(fx.latestDate)} · World Bank prices to {fmtMonthLong(cm.latestMonth)}</p>
    </div>
    <nav class="nav" aria-label="Main">
      <ul class="wrap">
        {navItems.map((n) => <li><a href={n.href} aria-current={nav === n.k ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
  </header>
  {crumbs && (
    <nav class="crumbs wrap" aria-label="Breadcrumb">
      <ol class="crumbs">
        {crumbs.map((c, i) => <li>{i !== crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
      </ol>
    </nav>
  )}
  <main id="main" class="wrap">
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap foot-grid">
      <div>
        <h2>{site.name}</h2>
        <p>{site.description}</p>
        <p>Reference rates and prices are historical records for information and education. They are not dealing quotes, forecasts or trading signals, and nothing here is financial advice. Exchange-rate data © European Central Bank (reuse permitted with source acknowledgement); commodity data © World Bank, licensed CC BY 4.0.</p>
        <p>This site shows advertising from Google AdSense. It has no affiliate or sponsored links.</p>
      </div>
      <div>
        <h2>Reference</h2>
        <ul>
          <li><a href="/fx/">Currency pairs</a></li>
          <li><a href="/commodities/">Commodity prices</a></li>
          <li><a href="/tools/historical-converter/">Historical converter</a></li>
          <li><a href="/tools/percent-change/">Percent change calculator</a></li>
          <li><a href="/guides/">Almanac guides</a></li>
          <li><a href="/feed.xml">RSS feed</a></li>
        </ul>
      </div>
      <div>
        <h2>House</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/methodology/">Methodology &amp; sources</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
        </ul>
      </div>
    </div>
  </footer>
  <script is:inline>
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('a[href^="http"]') : null;
      if (!a || !window.gtag) return;
      try {
        var u = new URL(a.href);
        if (u.host === location.host) return;
        var sponsored = /sponsored/.test(a.rel);
        window.gtag('event', sponsored ? 'outbound_affiliate_click' : 'outbound_source_click', { destination_host: u.host });
      } catch (err) {}
    });
  </script>
</body>
</html>
